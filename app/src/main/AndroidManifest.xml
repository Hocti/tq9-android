<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- RECORD_AUDIO 會暗示 microphone required=true，Play 會篩走目錄冇標咪嘅機。
         語音輸入係可選功能，咪唔係必備。 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- 開系統語音辨識嗰陣暫時靜音，遮住佢自己嗰兩下提示聲（見 TTInputMethodService.muteEarcons）。
         normal permission，安裝就有，唔會問使用者。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TT">

        <!-- adjustResize：不要讓系統在 pan / resize 之間自己揀。API 35+ 的 inset
             由 SettingsActivity.applyWindowInsets 自己處理，舊機則靠這個屬性 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MicPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TT.Transparent" />

        <service
            android:name=".ime.TTInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <!-- 系統認 IME 就靠呢個 action；唔好刪。 -->
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
